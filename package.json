{
  "name": "5dmind",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "workspaces": [
    "apps/api"
  ],
  "scripts": {
    "dev": "vite --port 1420",
    "dev:web": "vite --port 1420",
    "dev:desktop": "tauri dev",
    "dev:android": "tauri android dev",
    "dev:ios": "tauri ios dev",
    "tauri": "tauri",
    "build": "npm run build:web",
    "build:web": "tsc -b && vite build",
    "build:desktop": "tauri build",
    "build:android": "tauri android build --ci --target aarch64 --apk --aab",
    "build:ios": "tauri ios build",
    "version:set": "node scripts/set-version.mjs",
    "dev:api": "npm --workspace apps/api run dev",
    "build:api": "npm --workspace apps/api run build",
    "start:api": "npm --workspace apps/api run start",
    "test:api": "npm --workspace apps/api run test",
    "build:all": "npm run build:web && npm run build:api",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\""
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "katex": "^0.19.0",
    "lucide-react": "^1.48.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.0",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "prettier": "^3.9.10",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.1",
    "vitest": "^3.2.7"
  }
}
